    { "id": "RT-S35", "layer": "semantic", "name": "language outside enum", "proposal": { "segment": { "groups": [] }, "unsupported_criteria": [], "assumptions": [], "channels_requested": "both", "language": "de", "explanation": "x" }, "codes": ["invalid_enum_value"] },
    { "id": "RT-S36", "layer": "semantic", "name": "contradiction city eq A and city eq B", "proposal": { "segment": { "groups": [ { "conditions": [ { "field": "city", "op": "eq", "value": "Ankara" } ] }, { "conditions": [ { "field": "city", "op": "eq", "value": "İzmir" } ] } ] }, "unsupported_criteria": [], "assumptions": [], "channels_requested": "both", "language": "tr", "explanation": "x" }, "codes": ["contradiction"] },
