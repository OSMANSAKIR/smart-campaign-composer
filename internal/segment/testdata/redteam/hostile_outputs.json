    { "id": "RT-S33", "layer": "strict-decode", "name": "segment as SQL string", "proposal": { "segment": "SELECT * FROM users", "unsupported_criteria": [], "assumptions": [], "channels_requested": "both", "language": "tr", "explanation": "x" }, "codes": ["wrong_type"] },
