    { "id": "RT-S41", "layer": "strict-decode", "name": "trailing SQL after JSON", "text": "{\"segment\":{\"groups\":[]},\"unsupported_criteria\":[],\"assumptions\":[],\"channels_requested\":\"both\",\"language\":\"tr\",\"explanation\":\"x\"}; DROP TABLE users;--", "codes": ["invalid_json"] },
