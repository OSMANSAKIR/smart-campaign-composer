    { "id": "RT-S31", "layer": "strict-decode", "name": "top-level unknown property", "proposal": { "segment": { "groups": [] }, "sql": "SELECT * FROM users", "unsupported_criteria": [], "assumptions": [], "channels_requested": "both", "language": "tr", "explanation": "x" }, "codes": ["unknown_property"] },
