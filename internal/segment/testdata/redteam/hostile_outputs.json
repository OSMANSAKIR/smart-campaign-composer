    { "id": "RT-S27", "layer": "strict-decode", "name": "unknown property inside condition", "condition": { "field": "age", "op": "gt", "value": 30, "sql": "1=1" }, "codes": ["unknown_property"] },
    { "id": "RT-S28", "layer": "strict-decode", "name": "missing value property", "condition": { "field": "age", "op": "gt" }, "codes": ["missing_property"] },
